<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:theme="clr-namespace:SukiUI.Theme;assembly=SukiUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="850"
             x:Class="MSLX.Desktop.Views.SettingsPage">

    <UserControl.Styles>
        <Style Selector="Grid.SettingItem">
            <Setter Property="Margin" Value="15,10"/>
        </Style>
        <Style Selector="TextBlock.SettingTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="TextBlock.SettingDesc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="icons|MaterialIcon.SettingIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource SukiLightBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Margin" Value="0,5,0,20"/>
        </Style>
    </UserControl.Styles>

    <suki:GlassCard Margin="10">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="设置" Classes="h3"/>
                    <Button Name="BtnRefresh" 
                        VerticalAlignment="Center" Click="OnRefreshClick"
                        ToolTip.Tip="刷新数据">
                    <icons:MaterialIcon Kind="Refresh"/>
                </Button>
                </StackPanel>
                <ProgressBar Name="LoadingBar" 
                                 IsIndeterminate="True" 
                                 IsVisible="False" 
                                 Height="2" 
                                 VerticalAlignment="Bottom"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="0,0,15,0">
                <StackPanel>

                    <TextBlock Text="界面与外观 (APPEARANCE)" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="5,0,0,5"/>
                    <Border Classes="SectionCard">
                        <StackPanel>
                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="Palette" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="主题色" Classes="SettingTitle"/>
                                    <TextBlock Text="选择您喜欢的主题色调" Classes="SettingDesc"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" Name="ComboThemeColor" MinWidth="180" SelectionChanged="OnThemeColorChanged">
                                    <ComboBoxItem Content="默认蓝" Tag="Default"/>
                                    <ComboBoxItem Content="清霁蓝" Tag="Blue"/>
                                    <ComboBoxItem Content="竹月青" Tag="Teal"/>
                                    <ComboBoxItem Content="藤萝紫" Tag="Purple"/>
                                    <ComboBoxItem Content="落樱粉" Tag="Pink"/>
                                    <ComboBoxItem Content="暮云橙" Tag="Orange"/>
                                    <ComboBoxItem Content="朱砂红" Tag="Red"/>
                                    <ComboBoxItem Content="苍黛青" Tag="DarkCyan"/>
                                </ComboBox>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="ThemeLightDark" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="深色模式" Classes="SettingTitle"/>
                                    <TextBlock Text="设置应用的亮/暗色外观" Classes="SettingDesc"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" Name="ComboThemeMode" MinWidth="180" SelectionChanged="OnThemeModeChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                                    <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="ImageMultiple" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="背景设置应用范围" Classes="SettingTitle"/>
                                    <TextBlock Text="选择下方背景设置的应用范围 (全局/浅色/深色)" Classes="SettingDesc"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" Name="ComboBackgroundTarget" MinWidth="180" SelectionChanged="OnBackgroundTargetChanged">
                                    <ComboBoxItem Content="全局通用" Tag="Global"/>
                                    <ComboBoxItem Content="仅浅色模式" Tag="Light"/>
                                    <ComboBoxItem Content="仅深色模式" Tag="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto, Auto">
                                <icons:MaterialIcon Kind="Image" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="自定义背景图" Classes="SettingTitle"/>
                                    <TextBlock Text="设置应用的全局背景图片" Classes="SettingDesc"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="选择图片" Click="OnSelectBackgroundImage" Margin="0,0,10,0" />
                                <Button Grid.Column="3" Content="清除" Click="OnClearBackgroundImage" />
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="Opacity" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="背景不透明度" Classes="SettingTitle"/>
                                    <TextBlock Text="调节自定义背景图片的显示不透明度" Classes="SettingDesc"/>
                                </StackPanel>
                                <Slider Grid.Column="2" Name="SliderBackgroundOpacity" Minimum="0" Maximum="1" Value="0.8" MinWidth="180" ValueChanged="OnBackgroundOpacityChanged" />
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="Blur" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="背景高斯模糊" Classes="SettingTitle"/>
                                    <TextBlock Text="调节自定义背景图片的模糊程度" Classes="SettingDesc"/>
                                </StackPanel>
                                <Slider Grid.Column="2" Name="SliderBackgroundBlur" Minimum="0" Maximum="50" Value="0" MinWidth="180" ValueChanged="OnBackgroundBlurChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="守护进程设置 (DAEMON)" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="5,10,0,5"/>
                    <Border Classes="SectionCard">
                        <StackPanel>
                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="CloudSync" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="软件更新" Classes="SettingTitle"/>
                                    <TextBlock Text="检查并更新 MSLX 守护进程版本" Classes="SettingDesc"/>
                                </StackPanel>
                                <Button Grid.Column="2" Name="BtnCheckUpdate" Classes="Outlined" Click="OnCheckUpdateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="检查更新"/>
                                        <icons:MaterialIcon Kind="ChevronRight"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="Web" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="自动打开控制台" Classes="SettingTitle"/>
                                    <TextBlock Text="启动成功后自动打开网页控制台" Classes="SettingDesc"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" Name="SwitchWebConsole"/>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="ServerNetwork" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="安装镜像源" Classes="SettingTitle"/>
                                    <TextBlock Text="NeoForge / Forge 自动安装使用的下载源" Classes="SettingDesc"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" Name="ComboMirrors" Width="200">
                                    <ComboBoxItem Content="官方源 (较慢)" Tag="Official"/>
                                    <ComboBoxItem Content="MSL镜像源 (推荐)" Tag="MSL Mirrors"/>
                                    <ComboBoxItem Content="MSL镜像源 - 备用" Tag="MSL Mirrors Backup"/>
                                </ComboBox>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="Download" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="下载线程数量" Classes="SettingTitle"/>
                                    <TextBlock Text="文件下载时的并行分块线程数 (1-8，默认 5)" Classes="SettingDesc"/>
                                    <TextBlock Name="TxtDownloadThreadWarning" 
                                               Text="⚠️ 提示：线程数量过大可能导致拒绝连接或下载中断！" 
                                               FontSize="11" 
                                               Foreground="OrangeRed" 
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" 
                                               IsVisible="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Slider Name="SliderDownloadThreadCount" Minimum="1" Maximum="8" Value="5" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" />
                                    <TextBlock Name="TxtDownloadThreadCountVal" Text="5" Width="20" VerticalAlignment="Center" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="网络与安全 (NETWORK)" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="5,10,0,5"/>
                    <Border Classes="SectionCard">
                        <StackPanel>
                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="SecurityNetwork" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="禁止本地访问" Classes="SettingTitle"/>
                                    <TextBlock Text="禁止本地回环地址访问以增强安全性" Classes="SettingDesc"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Name="TxtFirewallStatus" Text="已关闭" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                                    <ToggleSwitch Name="SwitchFirewall"/>
                                </StackPanel>
                            </Grid>

                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="IpNetwork" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="监听地址" Classes="SettingTitle"/>
                                    <TextBlock Text="设置守护进程的监听 Host 和 Port (不知道这是什么请不要修改，需重启)" Classes="SettingDesc" Foreground="OrangeRed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                    <TextBox Name="TxtListenHost" PlaceholderText="localhost" Width="140"/>
                                    <TextBlock Text=":" VerticalAlignment="Center"/>
                                    <NumericUpDown Name="NumListenPort" Minimum="1" Maximum="65535" Value="1027" Width="100"/>
                                </StackPanel>
                            </Grid>
                            
                            <Separator Opacity="0.1" Margin="15,0"/>

                            <Grid Classes="SettingItem" ColumnDefinitions="Auto, *, Auto">
                                <icons:MaterialIcon Kind="RemoteDesktop" Classes="SettingIcon"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="远程访问" Classes="SettingTitle"/>
                                    <TextBlock Text="查看配置远程访问的官方文档" Classes="SettingDesc"/>
                                </StackPanel>
                                <Button Classes="Outlined" Grid.Column="2" Click="OnRemoteAccessHelpClick">
                                    <StackPanel Orientation="Horizontal">
										<icons:MaterialIcon Kind="OpenInNew" Width="20" Height="20" Margin="0,0,5,0"/>
                                    <TextBlock Text="查看文档" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnSave" 
                            Classes="Flat Primary" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,5,20"
                            Padding="30,10"
                            Click="OnSaveClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20"/>
                            <TextBlock Text="保存设置" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </suki:GlassCard>
</UserControl>