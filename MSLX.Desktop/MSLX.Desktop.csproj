<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
		<Version>1.5.9</Version>
		<AssemblyVersion>1.5.9</AssemblyVersion>
		<FileVersion>1.5.9</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<AssemblyName>MSLX-Desktop</AssemblyName>
		<AssemblyTitle>MSLX.Desktop</AssemblyTitle>
		<AssemblyDescription>MSLX Desktop</AssemblyDescription>
		<AssemblyCompany>MSLTeam</AssemblyCompany>
		<AssemblyCopyright>Copyright © 2021 - 2026 MSLTeam</AssemblyCopyright>
		<AssemblyTrademark>MSLTeam</AssemblyTrademark>
		<AssemblyCulture>zh-CN</AssemblyCulture>
		<NeutralLanguage>zh-CN</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Downloader" Version="4.1.0" />
		<PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.2" />
		<PackageReference Include="NetSparkleUpdater.UI.Avalonia" Version="3.1.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- 正式发布时通过 MSBuild 属性注入，仓库中不保存更新签名密钥。 -->
		<AssemblyMetadata Include="NetSparkleAppCastUrl"
						  Value="$(NetSparkleAppCastUrl)"
						  Condition="'$(NetSparkleAppCastUrl)' != ''" />
		<AssemblyMetadata Include="NetSparkleEd25519PublicKey"
						  Value="$(NetSparkleEd25519PublicKey)"
						  Condition="'$(NetSparkleEd25519PublicKey)' != ''" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<Content Include="Assets\icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SukiUI\SukiUI\SukiUI.csproj" />
		<ProjectReference Include="..\MSLX.SDK\MSLX.SDK.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Styles\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\CreateTunnel\MSLFrp\CreateMSLFrpTunnel.axaml.cs">
	    <DependentUpon>CreateMSLFrpTunnel.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\CreateTunnel\MSLFrp\MainPage.axaml.cs">
	    <DependentUpon>MainPage.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
