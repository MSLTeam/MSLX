{
  "name": "mslx-webpanel",
  "version": "1.7.9.1",
  "scripts": {
    "test:node": "node --test scripts/*.test.cjs",
    "dev": "node sync-version.js && vite --mode development",
    "dev:linux": "node sync-version.js && vite --mode development",
    "build:test": "node sync-version.js && vite build --mode test",
    "build": "node sync-version.js && vue-tsc --noEmit && vite build --mode release && node generate-build-info.js",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "stylelint": "stylelint src/**/*.{html,vue,sass,less}",
    "stylelint:fix": "stylelint --fix src/**/*.{html,vue,vss,sass,less}",
    "prepare": "node -e \"if(require('fs').existsSync('.git')){process.exit(1)}\" || is-ci || husky install",
    "site:preview": "pnpm run build && cp -r dist _site"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.38.0",
    "@microsoft/signalr": "^10.0.11",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-colors": "^4.1.3",
    "artplayer": "^5.4.0",
    "axios": "^1.21.1",
    "cron-parser": "^5.10.6",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "lodash": "4.18.1",
    "md-editor-v3": "^6.3.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "qrcode.vue": "^3.11.0",
    "qs": "^6.17.1",
    "tailwindcss": "^4.3.5",
    "tdesign-icons-vue-next": "^0.4.12",
    "tdesign-vue-next": "^1.20.11",
    "tvision-color": "^1.6.0",
    "typescript-eslint": "^8.46.2",
    "vue": "^3.5.45",
    "vue-clipboard3": "^2.0.0",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/lodash": "^4.17.27",
    "@types/qs": "^6.15.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/eslint-config-typescript": "^14.6.0",
    "browserslist": "^4.29.6",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.7.0",
    "eslint-plugin-vue-scoped-css": "^2.12.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-less": "^4.0.1",
    "stylelint-less": "^3.0.1",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^2.2.12"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "npm run lint:fix",
      "git add ."
    ],
    "*.{html,vue,vss,sass,less}": [
      "npm run stylelint:fix",
      "git add ."
    ]
  },
  "description": "MSLX Web Panel"
}
